# Export these variables in the shell running lbot-harness.
LBOT_LLM_URL=http://127.0.0.1:1234/v1
LBOT_LLM_MODEL=qwen3.5-4b
LBOT_LLM_API_KEY=lm-studio
LBOT_SIMULATOR_URL=http://127.0.0.1:3001
LBOT_BACKEND=simulator
LBOT_INFERENCE_TIMEOUT=60
LBOT_SKILL_TIMEOUT=180
LBOT_SEARCH_BUDGET=150
LBOT_EPISODE_TIMEOUT=300
# LBOT_TRANSLATOR_MODEL=/absolute/path/lbot_translator_v7.pt
# LBOT_TRACE_DIR=/absolute/path/runs
